{
  "name": "punkgrid-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PunkGrid Reality Engine — canonical simulation core (Sprint 1, no generative AI)",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc -p tsconfig.build.json",
    "seed": "npm run build && node dist/core/scripts/seed-glass-harbor.js",
    "eval:narrative": "npm run build && node dist/core/scripts/eval-narrative.js",
    "migrate": "npm run build && node dist/core/scripts/migrate.js",
    "serve": "npm run build && node dist/core/scripts/serve.js",
    "worker": "npm run build && node dist/core/scripts/worker.js",
    "token": "npm run build && node dist/core/scripts/token.js",
    "loadtest": "npm run build && node dist/core/scripts/loadtest.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "kysely": "^0.29.6",
    "pg": "^8.23.1"
  }
}
