ollable="false" long-clickable="false" password="false" selected="false" bounds="[1209,381][1269,441]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[75,633][135,693]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[1209,633][1269,693]" drawing-order="4" hint="" /></node></node><node index="4" text="" resource-id="" class="android.view.ViewGroup" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,768][1296,1775]" drawing-order="5" hint="" /><node index="5" text="The Glass Harbor · 2034 · C" resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,816][1248,873]" drawing-order="6" hint="" /><node index="6" text="Asterion bought the dockside lease in March, nine months before it needed it, through a company that exists in one filing." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,909][1248,1179]" drawing-order="7" hint="" /><node index="7" text="The ledger you would be selling is not the thing they want. They want the nine days, which means something in them is dated." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,1215][1248,1485]" drawing-order="8" hint="" /><node index="8" text="" resource-id="" class="android.view.View" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,1521][1248,1727]" drawing-order="9" hint="" /><node index="9" text="WHAT MOVED" resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,1560][1248,1609]" drawing-order="10" hint="" /><node index="10" text="You now know one fact nobody offered you, and knowing it has already changed what you can un-know." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[96,1621][1248,1727]" drawing-order="11" hint="" /><node index="11" text="" resource-id="" class="android.view.ViewGroup" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[48,1823][1296,20