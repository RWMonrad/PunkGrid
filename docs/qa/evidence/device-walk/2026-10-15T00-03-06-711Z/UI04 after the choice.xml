 drawing-order="10" hint="" /><node index="11" text="September 15, 2034, 09:00, by the world clock. The ledger's own words, with nothing added." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[99,1170][1245,1614]" drawing-order="11" hint="" /><node index="12" text="You chose, and the choice came back answered. What you hold has changed. Someone holds you at a different number than before. Something has begun that is not finished. It names Alex Vale, Mara Venn, Ilya Chen." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[99,1650][1245,2554]" drawing-order="12" hint="" /><node index="13" text="You stand where the record leaves you. The next offer comes from here." resource-id="" class="android.widget.TextView" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[99,2685][1245,2554]" drawing-order="13" hint="" /></node></node><node index="3" text="" resource-id="" class="android.view.View" package="com.monrad.punkgrid" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[0,2554][1344,2920]" drawing-order="4" hint=""><node index="0" text="" resource-id="" class="android.view.View" package="com.monrad.punkgrid" content-desc="Life Stream" checkable="false" checked="false" clickable="true" enabled="